{% comment %}
  Easy order COD app embed. Appears under Theme editor → App embeds.
  When enabled (and "Load marketing pixels" is on), loads the merchant's
  pixels from Connections site-wide and reports COD-button checkouts to them.
{% endcomment %}
{% if block.settings.load_pixels %}
  <script src="{{ 'cod-embed.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Easy order COD",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "load_pixels",
      "label": "Load marketing pixels from Connections",
      "default": true
    }
  ]
}
{% endschema %}
