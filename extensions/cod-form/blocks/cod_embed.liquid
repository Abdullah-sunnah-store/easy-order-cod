{% comment %}
  Easy order COD app embed. Appears under Theme editor → App embeds.
  When enabled, loads the merchant's marketing pixels site-wide.
{% endcomment %}
<script src="{{ 'cod-embed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Easy order COD",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "load_pixels",
      "label": "Load marketing pixels from Connections",
      "default": true
    }
  ]
}
{% endschema %}
