{% comment %}
  Cash-on-Delivery order block. A product-page button opens a centered modal
  where the customer picks a quantity and any add-on offers, then continues to
  Shopify checkout.

  The block deliberately collects NO customer or delivery information. Name,
  email, phone, shipping address, shipping rate, taxes and payment are all
  entered in Shopify checkout, which is the only place allowed to take them
  (App Store requirement 1.1.2 — apps must not bypass Shopify checkout). The
  merchant offers cash on delivery by enabling the manual "Cash on Delivery"
  payment method in Settings → Payments.

  This block has NO theme-editor settings by design: text, colours, layout,
  offers and countdown are configured in the Easy order COD app and fetched at
  runtime from /apps/cod/settings. Only product data — which the app can't know
  — comes from Liquid.
{% endcomment %}

{% if product %}
  {% assign v = product.selected_or_first_available_variant %}
  <div
    class="cod"
    data-cod-form
    data-variant-id="{{ v.id }}"
    data-price="{{ v.price }}"
    {% comment %} "id:price,id:price" so switching variant re-prices the summary. {% endcomment %}
    data-variants="{% for pv in product.variants %}{{ pv.id }}:{{ pv.price }}{% unless forloop.last %},{% endunless %}{% endfor %}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ v.image | default: product.featured_image | image_url: width: 100 }}"
    data-money-format="{{ shop.money_format | escape }}"
    {% comment %}
      Locale-aware cart root — a storefront served under /fr must not post to
      /cart. Every other cart URL is derived from this one in cod-form.js.
    {% endcomment %}
    data-cart-url="{{ routes.cart_url }}"
    {% comment %} Picks this product's offers and the visitor's language. {% endcomment %}
    data-product-id="{{ product.id }}"
    data-locale="{{ request.locale.iso_code }}"
  >
    <button type="button" class="cod__open" data-cod-open>Cash on Delivery</button>

    <div class="cod__overlay" data-cod-overlay>
      <div class="cod__modal" role="dialog" aria-modal="true">
        <div class="cod__head">
          <span>Order — Cash on Delivery</span>
          <button type="button" class="cod__close" data-cod-close aria-label="Close">&times;</button>
        </div>

        <form class="cod__form" data-cod-form-el>
          {% comment %} Quantity offers ("Buy 2, save 10%") replace the plain quantity field when the app has any for this product. {% endcomment %}
          <div class="cod__tiers" data-cod-tiers hidden></div>
          <div class="cod__row cod__qty" data-cod-field="quantity"><label>Quantity</label><input type="number" name="quantity" value="1" min="1" data-cod-qty /></div>

          {% comment %} Add-on offers are rendered by cod-form.js from the app settings. {% endcomment %}
          <div class="cod__offers" data-cod-offers hidden>
            <div class="cod__offers-title">Add to your order</div>
            <div data-cod-offers-list></div>
          </div>

          <div class="cod__summary" data-cod-summary></div>

          {% comment %}
            Says plainly where the rest of the order is completed, so nobody
            expects to finish buying inside this modal.
          {% endcomment %}
          <p class="cod__note" data-cod-note>
            Shipping, taxes and payment are completed at checkout.
          </p>

          <div class="cod__timer" data-cod-timer hidden></div>

          <button type="submit" class="cod__submit" data-cod-submit></button>
          <p class="cod__msg" data-cod-message hidden></p>
        </form>
      </div>
    </div>
  </div>
  {% comment %} Appearance, countdown and templates (kept apart to stay under the 10 KB per-file limit). {% endcomment %}
  <script src="{{ 'cod-style.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "COD Order Form",
  "target": "section",
  "stylesheet": "cod-form.css",
  "javascript": "cod-form.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Everything about this block — text, colours, layout, add-on offers and the countdown — is configured in the Easy order COD app. No setup is needed here. The customer's contact and delivery details are collected by Shopify checkout."
    }
  ]
}
{% endschema %}
