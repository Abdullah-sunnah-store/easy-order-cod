{% comment %}
  Cash-on-Delivery quick-order block.

  IMPORTANT — App Store requirement 1.1.2 (Use Shopify checkout):
  This block must NEVER collect contact or shipping-address details, choose a
  shipping rate, or price a delivery/COD fee. Those belong to Shopify checkout,
  and collecting them here is what got the app rejected (ref 129273).

  What it does instead: it lets the customer pick a quantity and any add-on
  offers, then builds a Shopify cart and sends them to Shopify checkout, where
  Shopify collects the address, quotes real shipping rates, and creates the
  order. Cash on Delivery is a manual payment method the merchant enables in
  Settings -> Payments; this app never creates an order itself.

  This block has NO theme-editor settings by design: text, colours and layout
  are configured in the Easy order COD app under Form settings, and fetched at
  runtime from /apps/cod/settings. Only product data comes from Liquid.
{% endcomment %}

{% if product %}
  {% assign v = product.selected_or_first_available_variant %}
  <div
    class="cod"
    data-cod-form
    data-variant-id="{{ v.id }}"
    data-price="{{ v.price }}"
    data-available="{{ v.available }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ v.image | default: product.featured_image | image_url: width: 100 }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-cart-url="{{ routes.cart_url }}"
    data-cart-add-url="{{ routes.cart_add_url }}"
    data-cart-update-url="{{ routes.cart_update_url }}"
  >
    <button type="button" class="cod__open" data-cod-open>Cash on Delivery</button>

    <div class="cod__overlay" data-cod-overlay>
      <div class="cod__modal" role="dialog" aria-modal="true">
        <div class="cod__head">
          <span>Order — Cash on Delivery</span>
          <button type="button" class="cod__close" data-cod-close aria-label="Close">&times;</button>
        </div>

        <form class="cod__form" data-cod-form-el>
          <div class="cod__row cod__qty" data-cod-field="quantity"><label>Quantity</label><input type="number" name="quantity" value="1" min="1" data-cod-qty /></div>

          {% comment %} Upsell offers are rendered by cod-form.js from the app settings. {% endcomment %}
          <div class="cod__offers" data-cod-offers hidden>
            <div class="cod__offers-title">Add to your order</div>
            <div data-cod-offers-list></div>
          </div>

          <div class="cod__summary" data-cod-summary></div>

          {% comment %}
            Shipping, taxes and any COD fee are quoted by Shopify at checkout.
            Never total them here — the number would be a guess, and pricing
            delivery outside checkout is what requirement 1.1.2 prohibits.
          {% endcomment %}
          <p class="cod__at-checkout" data-cod-at-checkout>Shipping, taxes and payment are calculated at checkout.</p>

          <div class="cod__timer" data-cod-timer hidden></div>

          {% comment %} Becomes the cart note, which Shopify carries onto the order. {% endcomment %}
          <div class="cod__row" data-cod-field="notes"><label>Note</label><input type="text" name="notes" /></div>

          <button type="submit" class="cod__submit" data-cod-submit></button>
          <p class="cod__msg" data-cod-message hidden></p>
        </form>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "COD Order Form",
  "target": "section",
  "stylesheet": "cod-form.css",
  "javascript": "cod-form.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Text, colours, layout, upsell offers and the countdown are configured in the Easy order COD app. No setup is needed here."
    },
    {
      "type": "paragraph",
      "content": "This form sends customers to Shopify checkout, where the delivery address, shipping rates and Cash on Delivery payment are handled by Shopify. Enable Cash on Delivery under Settings > Payments > Manual payment methods."
    }
  ]
}
{% endschema %}
