// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Vercel's Node runtime is Amazon Linux (OpenSSL 3). `prisma generate` runs
  // on the build machine so it resolves "native" to that anyway, but naming
  // the target explicitly stops a cached node_modules from shipping an engine
  // built for some other platform, which fails at runtime as a 500.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  // Postgres in EVERY environment, local development included.
  //
  // A Vercel function has no writable disk that survives the request, so a
  // SQLite file would take every merchant session with it. Postgres also has
  // to be the provider here rather than only on a deploy branch: Prisma
  // migrations are provider-specific SQL, so a second provider means a second
  // migration history, and the two drift. That drift is what left the deployed
  // branch four commits behind with a retired API version.
  //
  // One schema, one migration history, one deployable branch. Point
  // DATABASE_URL at a separate Neon branch for local dev so development never
  // writes to live merchant data. Use the POOLED host, keep ?sslmode=require.
  url      = env("DATABASE_URL")
  // Migrations must not run through the connection pooler: `prisma migrate
  // deploy` takes a session-level advisory lock, and PgBouncer hands each
  // statement a different backend, so the lock is taken on one connection and
  // looked for on another. Neon publishes the direct host as
  // DATABASE_URL_UNPOOLED, which the Vercel integration sets alongside the
  // pooled one. Runtime still uses the pooled URL above.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Per-shop configuration for the Cash-on-Delivery order form.
model CodSettings {
  shop           String   @id
  enabled        Boolean  @default(true)
  headingText    String   @default("Order — Cash on Delivery")
  buttonText     String   @default("Order Now (Cash on Delivery)")
  successMessage String   @default("Thank you! Your order has been placed. We'll call you to confirm.")
  orderTag       String   @default("COD")
  // Which fields to show on the storefront form.
  showName       Boolean  @default(true)
  showEmail      Boolean  @default(false)
  showPhone      Boolean  @default(true)
  showAddress    Boolean  @default(true)
  showCity       Boolean  @default(true)
  showQuantity   Boolean  @default(true)
  showNotes      Boolean  @default(false)
  // Country dial codes offered beside the phone field. Comma-separated; the
  // first entry is preselected. Customers can then type a local number
  // (01709504746) and still produce a valid international phone.
  dialCodes      String   @default("+880,+91,+92,+977,+94,+971,+966,+60,+65,+44,+1")
  // Fraud prevention
  otpEnabled         Boolean @default(false)
  phoneConfirmation  Boolean @default(false)
  ipBlockingEnabled  Boolean @default(false)
  blockedIps         String  @default("")
  blockedPostalCodes String  @default("")
  maxOrdersPerPhone  Int     @default(0)
  // Delivery / COD fees
  codFee                Float @default(0)
  shippingRate          Float @default(0)
  freeShippingThreshold Float @default(0)
  // Storefront presentation previously held in the theme block's schema.
  // currencySymbol "" = derive from the shop's own money format.
  currencySymbol   String @default("")
  countdownMinutes Int    @default(0)
  // JSON array of { name, price } shipping choices shown on the form. These are
  // the merchant's own hand-written rates.
  shippingOptions  String @default("[]")
  // Where the rates on the form come from: "manual" (shippingOptions only),
  // "auto" (rates synced from the shop's Shopify shipping zones) or "both".
  shippingMode     String   @default("manual")
  // Last successful sync of the shop's Shopify delivery profiles, as a JSON
  // array of { name, price }. Kept so the storefront still has rates when a
  // live refresh fails or is switched off.
  shippingSynced   String    @default("[]")
  shippingSyncedAt DateTime?
  // Re-pull the Shopify rates on every storefront request (cached briefly)
  // instead of only when the merchant presses "Sync now".
  shippingAutoSync Boolean   @default(false)
  // Synced rates the merchant switched off, as a JSON array of rate names.
  // Stored by name, not position, so a re-sync doesn't hide the wrong rate; a
  // newly appearing rate defaults to shown.
  shippingHiddenRates String @default("[]")
  // Dynamic rate: the price follows the city the customer types. JSON array of
  // { cities: "Dhaka, Gazipur", price, label }; the first matching rule wins and
  // shippingFallback* applies when nothing matches.
  shippingRulesEnabled  Boolean @default(false)
  shippingRules         String  @default("[]")
  shippingFallbackPrice Float   @default(0)
  shippingFallbackLabel String  @default("Delivery charge")
  // Form-builder appearance (JSON: form type, button styling, colors, radius…)
  builderConfig  String   @default("{}")
  updatedAt      DateTime @updatedAt
}

// Marketing pixels and third-party integrations ("Connections").
model Connections {
  shop               String   @id
  fbPixelId          String   @default("")
  tiktokPixelId      String   @default("")
  googleTagId        String   @default("")
  snapPixelId        String   @default("")
  pinterestTagId     String   @default("")
  googleSheetsEnabled Boolean @default(false)
  googleSheetUrl     String   @default("")
  smsProvider        String   @default("none")
  smsApiKey          String   @default("")
  smsSenderId        String   @default("")
  whatsappEnabled    Boolean  @default(false)
  whatsappPhone      String   @default("")
  updatedAt          DateTime @updatedAt
}

// Monthly COD order count per shop, used to enforce the plan's order limit.
// Keyed by UTC calendar month ("2026-08"); no customer data is stored here.
model UsageCounter {
  shop      String
  period    String
  count     Int      @default(0)
  // Sum of those orders' totals, in the shop's currency (Analytics page).
  revenue   Float    @default(0)
  // How many of them were tagged for review (blocked postal code / phone limit).
  flagged   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([shop, period])
}

// Every COD order the orders/create webhook has already handled. Shopify can
// deliver the same webhook more than once; inserting here first makes a repeat
// delivery a no-op instead of a second count against the plan. Holds only the
// order's GID — no customer data. Rows older than 60 days are pruned.
model ProcessedOrder {
  shop      String
  orderId   String
  createdAt DateTime @default(now())

  @@id([shop, orderId])
  @@index([createdAt])
}

// Upsell / order-bump offers configured by the merchant.
model Upsell {
  id                String   @id @default(cuid())
  shop              String
  title             String   @default("Special offer")
  type              String   @default("bump")
  // What is being offered, chosen with the Shopify resource picker.
  // offerKind "product" = one product (offerVariantId names the variant);
  // "collection" = any item from a collection.
  offerKind         String   @default("product")
  offerProductId    String   @default("")
  offerProductTitle String   @default("")
  offerVariantId    String   @default("")
  offerHandle       String   @default("")
  offerImage        String   @default("")
  // Amount only ("250.00") — rendered with the shop's own money format.
  offerPrice        String   @default("")
  // Collections: how many products are in it, shown as a hint in the table.
  offerProductCount Int      @default(0)
  discountPercent   Int      @default(0)
  minQuantity       Int      @default(1)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([shop])
}
