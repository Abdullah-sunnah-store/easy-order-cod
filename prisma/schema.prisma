// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  // Local dev: file:dev.sqlite (.env). No server to install, no signup.
  //
  // Hosting uses Postgres instead — Render's disk is ephemeral, so a SQLite
  // file there is wiped on every deploy. That conversion (provider, and a
  // Postgres baseline migration) lives on the `render-postgres` branch, which
  // is what Render deploys. Schema changes made here must be carried over to
  // that branch before the next deploy.
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Per-shop configuration for the Cash-on-Delivery order form.
model CodSettings {
  shop               String   @id
  enabled            Boolean  @default(true)
  headingText        String   @default("Order — Cash on Delivery")
  buttonText         String   @default("Order Now (Cash on Delivery)")
  // Cart attribute value stamped on COD carts so the merchant can recognise
  // these orders (and tag them with Shopify Flow). The app does not tag orders
  // itself — since requirement 1.1.2 it never writes an order at all.
  orderTag           String   @default("COD")
  // Which of the two remaining form fields to show. The contact and address
  // fields are gone: requirement 1.1.2 puts those in Shopify checkout.
  showQuantity       Boolean  @default(true)
  showNotes          Boolean  @default(false)
  // Fraud prevention
  otpEnabled         Boolean  @default(false)
  phoneConfirmation  Boolean  @default(false)
  ipBlockingEnabled  Boolean  @default(false)
  blockedIps         String   @default("")
  blockedPostalCodes String   @default("")
  maxOrdersPerPhone  Int      @default(0)
  // Storefront presentation previously held in the theme block's schema.
  // currencySymbol "" = derive from the shop's own money format.
  currencySymbol     String   @default("")
  countdownMinutes   Int      @default(0)
  // Line under the summary telling the customer that shipping, taxes and
  // payment are settled on Shopify's checkout page.
  checkoutNotice     String   @default("Shipping, taxes and payment are calculated at checkout.")
  // Form-builder appearance (JSON: form type, button styling, colors, radius…)
  builderConfig      String   @default("{}")
  updatedAt          DateTime @updatedAt
}

// Marketing pixels and third-party integrations ("Connections").
model Connections {
  shop                String   @id
  fbPixelId           String   @default("")
  tiktokPixelId       String   @default("")
  googleTagId         String   @default("")
  snapPixelId         String   @default("")
  pinterestTagId      String   @default("")
  googleSheetsEnabled Boolean  @default(false)
  googleSheetUrl      String   @default("")
  smsProvider         String   @default("none")
  smsApiKey           String   @default("")
  smsSenderId         String   @default("")
  whatsappEnabled     Boolean  @default(false)
  whatsappPhone       String   @default("")
  updatedAt           DateTime @updatedAt
}

// Monthly COD order count per shop, used to enforce the plan's order limit.
// Keyed by UTC calendar month ("2026-08"); no customer data is stored here.
model UsageCounter {
  shop      String
  period    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([shop, period])
}

// Upsell / order-bump offers configured by the merchant.
model Upsell {
  id                String   @id @default(cuid())
  shop              String
  title             String   @default("Special offer")
  type              String   @default("bump")
  // What is being offered, chosen with the Shopify resource picker.
  // offerKind "product" = one product (offerVariantId names the variant);
  // "collection" = any item from a collection.
  offerKind         String   @default("product")
  offerProductId    String   @default("")
  offerProductTitle String   @default("")
  offerVariantId    String   @default("")
  offerHandle       String   @default("")
  offerImage        String   @default("")
  // Amount only ("250.00") — rendered with the shop's own money format.
  offerPrice        String   @default("")
  // Collections: how many products are in it, shown as a hint in the table.
  offerProductCount Int      @default(0)
  discountPercent   Int      @default(0)
  minQuantity       Int      @default(1)
  enabled           Boolean  @default(true)
  // The Shopify discount that actually applies this offer's percentage. The app
  // can no longer price an order line itself (requirement 1.1.2), so the
  // discount lives in the merchant's admin and is named on the checkout URL.
  discountId        String   @default("")
  discountCode      String   @default("")
  createdAt         DateTime @default(now())

  @@index([shop])
}

// COD orders seen on the orders/create webhook, identified by the cart
// attribute the storefront form sets. Shopify creates these orders at its own
// checkout; this table only records that one happened, for the Orders page and
// the plan's monthly allowance. Deliberately holds no customer data.
model CodOrder {
  shop      String
  orderId   String
  name      String   @default("")
  period    String
  createdAt DateTime @default(now())

  @@id([shop, orderId])
  @@index([shop, period])
}
